@Article{electronics11040626,
AUTHOR = {Tomic, Igor and Bleakley, Eoin and Ivanis, Predrag},
TITLE = {Predictive Capacity Planning for Mobile Networks&mdash;ML Supported Prediction of Network Performance and User Experience Evolution},
JOURNAL = {Electronics},
VOLUME = {11},
YEAR = {2022},
NUMBER = {4},
ARTICLE-NUMBER = {626},
URL = {https://www.mdpi.com/2079-9292/11/4/626},
ISSN = {2079-9292},
ABSTRACT = {Network performance prediction is crucial for enabling agile capacity planning in mobile networks. One of the key problems is predicting evolution of spectral efficiency in growing network load conditions. The main factor driving network performance and spectral efficiency is reportedly the Channel Quality Indicator (CQI). In this paper, the performance of different Machine Learning (ML) models were examined, and XGBoost was selected as the best performing model. Furthermore, to improve modeling accuracy, several features were introduced (operating frequency band, Physical Resource Block (PRB) utilization in surrounding cells, number of surrounding cells within a radius, heavy data factor and higher order modulation usage). The impact of these features on CQI prediction were examined.},
DOI = {10.3390/electronics11040626}
}


